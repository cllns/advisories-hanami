
<div class="container">
  <h2 class="h1 mb-5">
   Browse Security Advisories
  </h2>

  <div class="row">
    <div class="col-lg-8">
      <div class="listing-controls p-3 mb-5 rounded">
    
    <div class="row">
      <div class="col-8">
        <p class="mb-0">
          <% if severity %>
            <strong><%= humanize(severity) %></strong>
          <% end %>
          Security Advisories
          <% if package_name %>
            for <strong><%= package_name %></strong>
          <% end %>
          <% if repository_url %>
            for <strong><%= repository_url %></strong>
          <% end %>
          <% if ecosystem %>
            in <strong><%= ecosystem %></strong>
          <% end %>
          <% if [ecosystem, package_name, repository_url, severity].any? %>
            <a href="/advisories" class="btn btn-link btn-clear p-0">Clear Filters</a>
          <% end %>
        </p>
      </div>
  
          <div class="col-4  text-end">
            <%= render 'sort' %>
          </div>
        </div>
      </div>
      <% advisories.each do |advisory| %>
        <%= render 'advisory', advisory: advisory %>
      <% end %>
      <% if pagination[:total_pages] > 1 %>
        <nav>
          <ul class="pagination">
            <% if pagination[:current_page] > 1 %>
              <li class="page-item">
                <a class="page-link" href="<%= url_for(page: pagination[:current_page] - 1) %>">Previous</a>
              </li>
            <% end %>
            <% (1..pagination[:total_pages]).each do |page| %>
              <li class="page-item <%= 'active' if page == pagination[:current_page] %>">
                <a class="page-link" href="<%= url_for(page: page) %>"><%= page %></a>
              </li>
            <% end %>
            <% if pagination[:current_page] < pagination[:total_pages] %>
              <li class="page-item">
                <a class="page-link" href="<%= url_for(page: pagination[:current_page] + 1) %>">Next</a>
              </li>
            <% end %>
          </ul>
        </nav>
      <% end %>  
    </div>
    <div class="col-lg-4 listing-filters">
      <h3 class="h4 mx-3">Filter by Severity</h3>
      <div class="list-group list-group-flush">
        <% severities.each do |sev, count| %>
          <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= 'active' if severity == sev %>" href="<%= url_for(severity: (severity == sev ? nil : sev), page: nil) %>">
            <%= humanize(sev) %>
            <span class="badge bg-primary rounded-pill"><%= number_with_delimiter count %></span>
          </a>
        <% end %>
      </div>

      <h3 class="h4 mt-5 mx-3">Filter by Ecosystem</h3>
      <div class="list-group list-group-flush">
        <% ecosystems.each do |eco, count| %>
          <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= 'active' if ecosystem == eco %>" href="<%= url_for(ecosystem: (ecosystem == eco ? nil : eco), page: nil) %>">
            <%= eco %>
            <span class="badge bg-primary rounded-pill"><%= number_with_delimiter count %></span>
          </a>
        <% end %>
      </div>

      <h3 class="h4 mt-5 mx-3">Filter by Package</h3>
      <div class="list-group list-group-flush">
        <% packages.first(200).each do |package, count| %>
          <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= 'active' if package_name == package['package_name'] %>" href="<%= url_for(package_name: (package_name == package['package_name'] ? nil : package['package_name']), page: nil) %>">
            <%= package['package_name'] %>
            <span class="badge bg-primary rounded-pill"><%= number_with_delimiter count %></span>
          </a>
        <% end %>
      </div>
    
      <h3 class="h4 mt-5 mx-3">Filter by Repository</h3>
      <div class="list-group list-group-flush">
        <% repository_urls.first(200).each do |repo_url, count| %>
          <% next if repo_url.nil? || repo_url.empty? %>
          <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= 'active' if repository_url == repo_url %>" href="<%= url_for(repository_url: (repository_url == repo_url ? nil : repo_url), page: nil) %>">
            <%= repo_url %>
            <span class="badge bg-primary  rounded-pill"><%= number_with_delimiter count%></span>
          </a>
        <% end %>
      </div>

    </div>
  </div>
</div>
