<div class="dropdown">
	<button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
		Sort
	</button>
	<ul class="dropdown-menu">
		<% [['severity', 'desc', 'Highest Severity'],['severity', 'asc', 'Lowest Severity'],['blast_radius', 'desc', 'Blast Radius'],['published_at', 'desc', 'Recently Published'],['cvss_score','desc','CVSS Score'], ['epss_percentage', 'desc', 'EPSS Percentage'], ['epss_percentile', 'desc', 'EPSS Percentile']].each do |sort_field, order_field, name| %>
		<li><a class="dropdown-item <%= 'active' if sort == sort_field %>" href="<%= url_for(sort: sort_field, order: order_field) %>"><%= name %></a></li>
		<% end %>
	</ul>
</div>